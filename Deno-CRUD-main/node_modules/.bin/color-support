#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.deno/color-support@1.1.3/node_modules/color-support/bin.js" "$@"
else
  exec node  "$basedir/../.deno/color-support@1.1.3/node_modules/color-support/bin.js" "$@"
fi
